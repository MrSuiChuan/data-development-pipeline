{
  "description": "data-development-plugin 三层防线：PreToolUse 硬门（decision:block）+ PostToolUse 验证器软提示（注入 context 键）+ SessionStart 状态提醒。命令使用 py -3（Windows）；macOS/Linux 请把命令里的 py -3 换成 python3。",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/pretooluse.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/posttooluse.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/sessionstart.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
